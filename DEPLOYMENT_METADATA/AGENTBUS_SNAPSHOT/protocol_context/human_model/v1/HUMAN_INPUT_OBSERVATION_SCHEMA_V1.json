{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Duo Open Human Input Observation V1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "timestamp_utc",
    "agent",
    "request_type",
    "normalized_intent",
    "communication_signals"
  ],
  "properties": {
    "schema": {
      "const": "duoopen-human-input-observation/v1"
    },
    "id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "request_type": {
      "enum": [
        "question",
        "directive",
        "correction",
        "enhancement",
        "verification",
        "packaging",
        "handoff",
        "autonomy",
        "other"
      ]
    },
    "normalized_intent": {
      "type": "string"
    },
    "communication_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_excerpt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "sensitive_content_removed": {
      "type": "boolean"
    },
    "actual_next_request_archetype": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
