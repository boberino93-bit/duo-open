{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duoopen.local/agentbus/v2/schemas/fsm-definition.schema.json",
  "title": "Deterministic FSM Definition V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fsm_id",
    "version",
    "initial_state",
    "states",
    "terminal_states",
    "transitions"
  ],
  "properties": {
    "schema": {"const": "duoopen-agentbus/fsm-definition-v1"},
    "fsm_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "initial_state": {"type": "string", "minLength": 1, "maxLength": 128},
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "terminal_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "on", "to"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "from": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "on": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "to": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "when": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "equals"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 512},
                "equals": {"type": ["string", "integer", "boolean", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
