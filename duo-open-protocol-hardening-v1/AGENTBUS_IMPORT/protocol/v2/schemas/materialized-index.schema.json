{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duoopen.local/agentbus/v2/schemas/materialized-index.schema.json",
  "title": "Materialized Index Specification V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index_id",
    "version",
    "source",
    "key_paths",
    "value_paths",
    "reducer",
    "rebuildable",
    "retention_class"
  ],
  "properties": {
    "schema": {"const": "duoopen-agentbus/materialized-index-v1"},
    "index_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "integer", "minimum": 1},
    "source": {"const": "persisted-events"},
    "filter": {
      "type": "object",
      "propertyNames": {"minLength": 1, "maxLength": 512},
      "additionalProperties": {"type": ["string", "integer", "boolean", "null"]}
    },
    "key_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "value_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "explode_array_key": {"type": "boolean"},
    "reducer": {"type": "string", "enum": ["unique", "append", "latest", "max"]},
    "rebuildable": {"const": true},
    "retention_class": {"const": "derived"}
  }
}
