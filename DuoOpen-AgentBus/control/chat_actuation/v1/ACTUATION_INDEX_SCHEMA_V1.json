{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "duoopen-chat-actuation-index/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "source_repo", "source_branch", "generation", "max_managed_child_tabs", "entries"],
  "properties": {
    "schema": {"const": "duoopen-chat-actuation-index/v1"},
    "project": {"const": "duo-open"},
    "source_repo": {"const": "boberino93-bit/duo-open"},
    "source_branch": {"const": "main"},
    "generation": {"type": "integer", "minimum": 1},
    "max_managed_child_tabs": {"type": "integer", "minimum": 1, "maximum": 19},
    "entries": {
      "type": "array",
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round_id", "ticket_id", "role", "generation", "desired_state"],
        "properties": {
          "round_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
          "ticket_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
          "role": {"enum": ["MANAGER_REVIEWER", "RESEARCH"]},
          "generation": {"type": "integer", "minimum": 1},
          "desired_state": {"enum": ["RUNNING", "STOPPED"]}
        }
      }
    }
  }
}
