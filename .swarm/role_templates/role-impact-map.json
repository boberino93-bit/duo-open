{
  "schema": "duo-open/role-impact-map/v1",
  "roles": ["PRIMARY", "MANAGER", "RESEARCHER"],
  "default_roles": ["PRIMARY", "MANAGER"],
  "rules": [
    {"glob": ".swarm/generated/**", "roles": []},
    {"glob": ".swarm/**", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]},
    {"glob": "AUTHORITY_SECURITY_OVERLAY.json", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]},
    {"glob": "AGENT_BOOTSTRAP.*", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]},
    {"glob": "AGENT_DISCOVERY*", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]},
    {"glob": "AGENTBUS_IMPORT/**", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]},
    {"glob": "**/*agentbus*", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]},
    {"glob": "**/research/**", "roles": ["MANAGER", "RESEARCHER"]},
    {"glob": "**/*research*", "roles": ["MANAGER", "RESEARCHER"]},
    {"glob": "**/test*/**", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "**/*Test.*", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "app/**", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "src/**", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "android/**", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "**/*.kt", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "**/*.java", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "**/*.gradle", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "**/*.gradle.kts", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "scripts/**", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "build*/**", "roles": ["PRIMARY", "MANAGER"]},
    {"glob": "DEPLOYMENT_METADATA/**", "roles": ["PRIMARY", "MANAGER", "RESEARCHER"]}
  ]
}
